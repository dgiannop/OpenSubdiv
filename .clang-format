BasedOnStyle: LLVM
IndentWidth: 4
BraceWrapping:
  AfterClass: true
  AfterControlStatement: true
  AfterEnum: true
  AfterFunction: true
  AfterNamespace: true
  AfterStruct: true
  BeforeCatch: true
  BeforeElse: true
  IndentBraces: false
  SplitEmptyFunction: false  # Keep empty function braces on the same line
  SplitEmptyRecord: false    # Keep empty class/struct braces on the same line
AccessModifierOffset: -4
